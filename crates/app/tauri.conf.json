{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Supershop POS",
  "version": "0.1.0",
  "identifier": "com.supershop.pos",
  "build": {
    "beforeDevCommand": "pnpm --filter ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter ui build",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Supershop POS",
        "width": 1366,
        "height": 768,
        "minWidth": 1024,
        "minHeight": 600,
        "theme": "Light",
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
