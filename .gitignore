# Rust build output
/target/
**/target/

# UI dependencies and builds
node_modules/
ui/dist/
ui/src/generated/*.tmp

# Local databases, backups, logs and dev print previews
*.sqlite
*.sqlite-wal
*.sqlite-shm
dev-prints/
logs/

